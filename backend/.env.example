# Server
PORT=3000
NODE_ENV=production

# JWT Authentication
JWT_SECRET=replace-with-a-strong-random-64-char-secret
JWT_EXPIRES_IN=24h

# Google Apps Script Web App API (/exec)
GAS_WEB_APP_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
GAS_API_SECRET=replace-with-shared-gas-api-secret

# Optional Rental Gate External API Token (stored server-side only)
RG_API_TOKEN=
RG_RESERVATIONS_API=https://api.rentalgate.net/api/reservations/filter
RG_EXTENDS_API=https://api.rentalgate.net/api/reservation-extends/filter

# CORS Allowed Origins (comma-separated, e.g. https://your-frontend.vercel.app,https://your-site.pages.dev)
CORS_ORIGIN=*
