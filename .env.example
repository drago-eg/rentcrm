# ==============================================================================
# RENTAL GATE CRM — Environment Variables
# ==============================================================================

# Server Port
PORT=3000
NODE_ENV=development

# JWT Secret (Use a strong random 64-character string in production)
JWT_SECRET=replace-with-strong-random-64-char-secret
JWT_EXPIRES_IN=24h

# Google Apps Script Web App API (/exec)
GAS_WEB_APP_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
GAS_API_SECRET=replace-with-shared-gas-api-secret

# Optional External Rental Gate API Integration (Server-side only)
RG_API_TOKEN=
RG_RESERVATIONS_API=https://api.rentalgate.net/api/reservations/filter
RG_EXTENDS_API=https://api.rentalgate.net/api/reservation-extends/filter

# CORS Origin (comma-separated URLs or * for testing)
CORS_ORIGIN=*

# Frontend API Base URL (used during frontend Vite build if hosted separately)
VITE_API_BASE_URL=
